# Верхній рівень — не шукати .editorconfig у батьківських папках
root = true

# Для всіх файлів
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# У Markdown два пробіли в кінці рядка означають перенос
[*.md]
trim_trailing_whitespace = false
